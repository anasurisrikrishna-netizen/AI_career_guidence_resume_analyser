# Copy this file to .env for local development. Never commit real credentials.
SECRET_KEY=replace-with-a-long-random-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY_CODE=in
JOB_SEARCH_TIMEOUT_SECONDS=8
AI_MAX_INPUT_TOKENS=20000
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_DAILY_TOKENS_PER_USER=100000
AI_RETRY_ATTEMPTS=3
AI_RETRY_BASE_SECONDS=0.5
DATABASE_URL=
MAX_UPLOAD_BYTES=5242880
MAX_RESUME_TEXT_CHARS=50000
MAX_RESUME_PAGES=80
UPLOAD_FOLDER=instance/uploads
SESSION_COOKIE_SECURE=false
RATELIMIT_DEFAULT=200 per day, 50 per hour
RATELIMIT_STORAGE_URI=memory://
